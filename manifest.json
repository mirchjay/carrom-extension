{
  "manifest_version": 3,
  "name": "Carrom 2D",
  "version": "1.0",
  "description": "Play a 2D singleplayer & multiplayer Carrom game right from your browser extensions!",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": []
}